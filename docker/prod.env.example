# Copy to docker/.env (git-ignored). Read by docker compose for variable substitution.
# Your real domain: its DNS A record must point at this server BEFORE the first start, or HTTPS certificates cannot be issued.
APP_DOMAIN=app.example.com
# Generate with:  openssl rand -hex 24      (hex avoids characters that break the connection string)
MONGO_PASSWORD=change-me-generate-with-openssl-rand-hex-24
