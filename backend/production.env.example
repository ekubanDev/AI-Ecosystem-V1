# Copy to backend/.env.production (git-ignored) on the server. Secrets live here only: never commit this file.
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Behind Caddy there is exactly one proxy hop. Without this, every visitor shares the proxy's IP, so rate limits hit everyone at once.
TRUST_PROXY=1
# Indexes enforce uniqueness (slugs, one lead per email per page). Production defaults them OFF, so they must be switched on here.
MONGO_AUTO_INDEX=true

# Must equal https://<APP_DOMAIN> exactly. Used for CORS, the refresh-cookie Origin check and email links.
CLIENT_URL=https://app.example.com
COOKIE_SAMESITE=lax

# Generate two DIFFERENT values:  openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
BCRYPT_ROUNDS=12

RATE_LIMIT_ENABLED=true

# Anyone on the internet could otherwise create an account and read your research. Create the owner with the seed script (docs/DEPLOY.md).
# To add a teammate: set true, restart the backend, let them register, promote them in the Users page, then set it back to false.
REGISTRATION_ENABLED=false

# Email (Gmail app password) and AI / search. Rotate any key that has ever been pasted into a chat or ticket.
EMAIL_FROM=AI Business Factory <no-reply@example.com>
GMAIL_USER=
GMAIL_APP_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# USD per MILLION tokens (e.g. 0.4 and 1.6), not per token
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_BLOCKED_DOMAINS=finance.yahoo.com,rocketreach.co
