NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Set to the number of reverse proxies in front of the API (e.g. 1 behind nginx/ALB) so rate limiting sees real client IPs.
TRUST_PROXY=false

MONGODB_URI=mongodb://localhost:27017/ai_business_factory
# "text" uses the MongoDB text index; "regex" is a portable fallback for MongoDB-compatible servers without $text.
SEARCH_MODE=text

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  (min 32 chars, must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_SAMESITE=lax

# Comma-separated list of allowed browser origins (first one is used in emails).
CLIENT_URL=http://localhost:3000
EMAIL_FROM=AI Business Factory <no-reply@localhost>
# Email: set both to send through Gmail SMTP with an App Password (https://myaccount.google.com/apppasswords; needs 2-step
# verification). Leave both empty to log verification/reset links to the server log instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional USD per 1M tokens. If unset, AgentRun.estimatedCost is null (cost is never guessed).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# Web research for agents: none | tavily | brave. Without it agents cannot gather sources and report thin evidence.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

RUN_WORKER=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
MAX_AGENT_RETRIES=3
RETRY_BASE_DELAY_MS=5000
AGENT_TIMEOUT_MS=180000
DISCOVERY_MAX_COUNT=50

# Experiments with a budget above this need OWNER/ADMIN to start.
EXPERIMENT_APPROVAL_BUDGET_THRESHOLD=0

# Hosts whose search results are dropped (comma-separated)
SEARCH_BLOCKED_DOMAINS=finance.yahoo.com,rocketreach.co

# Public sign-up is open by default (development). Production closes it: create the owner with the seed script instead.
REGISTRATION_ENABLED=true
